{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "/home/adman/.local/share/fnm/node-versions/v22.23.2/installation/bin/node",
          "/home/adman/.local/lib/node_modules/@playwright/mcp/cli.js"
        ],
        "timeout": 30000
      },
      "supabase": {
        "type": "local",
        "command": [
          "/home/adman/.local/share/fnm/node-versions/v22.23.2/installation/bin/npx",
          "-y",
          "@supabase/mcp-server-supabase@latest",
          "--read-only",
          "--project-ref=lmkomzqioneuyvatzsov"
        ],
        "environment": {
          "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
        },
        "timeout": 30000
      },
      "github": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "medlink-*",
      "effect": "allow"
    }
  ]
}